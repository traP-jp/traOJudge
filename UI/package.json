{
  "name": "@traojudge/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build-only --",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint '**/*.{js,mjs,cjs,ts,vue}' './*.js' './*.ts'",
    "lint:debug": "eslint ./src --debug",
    "lint:fix": "eslint ./src --fix",
    "format": "prettier --write src/",
    "format:yaml": "prettier --write '../**/*.{yaml,yml}'",
    "format:yaml:check": "prettier --check '../**/*.{yaml,yml}'",
    "prepare": "cd .. && git config core.hooksPath .husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/eslint__js": "8.42.3",
    "jwt-decode": "4.0.0",
    "markdown-it": "14.3.3",
    "monaco-editor": "0.52.2",
    "pinia": "3.0.4",
    "shiki": "1.29.2",
    "validator": "13.15.22",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint/js": "9.39.1",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@rushstack/eslint-patch": "1.16.1",
    "@shikijs/monaco": "1.29.2",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node24": "24.0.5",
    "@types/jwt-decode": "3.1.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.19.2",
    "@types/validator": "13.15.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-tailwindcss": "4.4.0",
    "eslint-plugin-unicorn": "64.0.0",
    "eslint-plugin-vue": "9.33.0",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.4",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "error"
    }
  },
  "overrides": {
    "get-uri@8.0.1": {
      "basic-ftp": "6.2.3"
    }
  }
}
