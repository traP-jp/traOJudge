{
  "name": "@traojudge/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build-only --",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --max-warnings=0",
    "lint:debug": "npm run lint -- --debug",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write . ../docs/ui",
    "format:yaml": "prettier --write '../**/*.{yaml,yml}'",
    "format:yaml:check": "prettier --check '../**/*.{yaml,yml}'",
    "prepare": "cd .. && git config core.hooksPath .husky || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lint": "node scripts/lint.test.mjs",
    "format:check": "prettier --check . ../docs/ui",
    "mock": "mockoon-cli start --data ./src/api/mock/front-back-api-mock.json --hostname 127.0.0.1 --disable-admin-api --watch"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tanstack/vue-query": "5.104.4",
    "@vscode/markdown-it-katex": "1.1.2",
    "dompurify": "3.4.17",
    "katex": "0.18.3",
    "markdown-it": "14.3.3",
    "monaco-editor": "0.52.2",
    "openapi-fetch": "0.17.0",
    "pinia": "3.0.4",
    "shiki": "1.29.2",
    "validator": "13.15.22",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
    "@eslint/js": "10.0.1",
    "@mockoon/cli": "9.9.0",
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@shikijs/monaco": "1.29.2",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node24": "24.0.5",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.19.2",
    "@types/validator": "13.15.4",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "eslint-plugin-unicorn": "64.0.0",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vuejs-accessibility": "2.6.2",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0",
      "onFail": "error"
    }
  },
  "overrides": {
    "get-uri@8.0.1": {
      "basic-ftp": "6.2.3"
    },
    "@mockoon/cli@9.9.0": {
      "@modelcontextprotocol/sdk": "1.32.1",
      "zod": "4.6.6"
    },
    "@mockoon/commons-server@9.9.0": {
      "handlebars": "4.7.10",
      "@faker-js/faker": "10.6.0"
    },
    "@vscode/markdown-it-katex@1.1.2": {
      "katex": "$katex"
    }
  }
}
